# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Supabase.
# Nunca comite o ".env.local" (já está no .gitignore).

# Painel Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave pública VAPID, pra notificações push (a privada fica só no backend)
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
